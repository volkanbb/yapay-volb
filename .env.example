# YAPAY VOLB — copy to .env and adjust. Values saved in the Settings page (SQLite) override these.
VOLB_LANGUAGE=tr                 # tr | en | auto  (speech recognition language)
VOLB_WAKE_WORD=volb
VOLB_AI_PROVIDER=claude_cli      # claude_cli (Claude Pro via Claude Code) | ollama | anthropic_api
VOLB_CLAUDE_MODEL=               # empty = Claude Code default; e.g. sonnet, opus
VOLB_OLLAMA_MODEL=llama3.1
VOLB_STT_MODEL=small             # tiny | base | small | medium | large-v3 | turbo
VOLB_STT_DEVICE=auto             # auto | cuda | cpu
VOLB_TTS_ENGINE=piper            # piper | edge | none
VOLB_PIPER_VOICE=tr_TR-dfki-medium
VOLB_EDGE_VOICE=tr-TR-AhmetNeural
VOLB_ALLOW_EDGE_TTS=false        # Edge TTS sends text to Microsoft
VOLB_BROWSER_HEADLESS=false      # search engines block headless browsers; API fallbacks are used then
VOLB_SEMANTIC_MEMORY=false       # needs: pip install chromadb
# VOLB_SEARXNG_URL=http://localhost:8080   # optional self-hosted SearXNG for research
# NOTE: ANTHROPIC_API_KEY is deliberately NOT read by the Claude Code provider — it is stripped
# from the CLI environment so your Claude Pro subscription is used, never paid API billing.
